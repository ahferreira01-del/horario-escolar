# Copie para ops/production.env (arquivo local IGNORADO pelo Git).
# NÃO utilize valores de exemplo na implantação. Permissão do arquivo: chmod 600.
# Host DNS público deve apontar para o servidor com portas 80/443 acessíveis.
HI_PUBLIC_HOST=horarios.example.org

# Preferir segredos aleatórios de 48+ caracteres; alfanuméricos dispensam percent-encoding.
# A senha do owner NÃO deve ser exposta aos processos web/API.
HI_POSTGRES_OWNER_PASSWORD=REPLACE_WITH_STRONG_RANDOM_OWNER_PASSWORD
HI_POSTGRES_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_RUNTIME_PASSWORD
# URLs a seguir devem conter as MESMAS senhas acima, URL-encoded quando necessário.
HI_DB_OWNER_URL=postgresql+psycopg://horario_owner:REPLACE_WITH_STRONG_RANDOM_OWNER_PASSWORD@db:5432/horario
HI_DB_RUNTIME_URL=postgresql+psycopg://horario_runtime:REPLACE_WITH_DIFFERENT_STRONG_RUNTIME_PASSWORD@db:5432/horario

HI_SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_SESSION_SECRET_AT_LEAST_40_CHARACTERS
HI_SESSION_MAX_MINUTES=120

# Provisionamento administrativo manual é o padrão e não exige envio de e-mail.
HI_USER_PROVISIONING_MODE=manual
# SMTP só é necessário quando USER_PROVISIONING_MODE=email for escolhido.
# HI_SMTP_HOST=
# HI_SMTP_PORT=587
# HI_SMTP_USER=
# HI_SMTP_PASSWORD=
# HI_SMTP_FROM=
